# ============================================================
# SERA — Environment Variables Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# ── HuggingFace Token (required) ────────────────────────────
# Used to download the BAAI/bge-m3 embedding model.
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ── Local LLM Inference Server ───────────────────────────────
# URL of the OpenAI-compatible API served by Ollama / vLLM / LM Studio.
# Running bare Python (not Docker):
#   LLM_BASE_URL=http://localhost:11434/v1
# Running inside Docker container:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1

# ── Model Names (must match what your inference server serves) ─
GENERATOR_LLM_MODEL=Meta-Llama-3.1-8B-Instruct
SUMMARIZER_LLM_MODEL=Qwen-2.5-32B-Instruct
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ── Optional: Override thresholds ────────────────────────────
# (defaults are already set in app/config.py — only change if needed)
# COSINE_THRESHOLD=0.92
# HIT_COUNT_THRESHOLD=10
# RESYNTH_DELTA=10
# POLL_INTERVAL_MINUTES=5
# VALIDATION_COVERAGE_THRESHOLD=0.90
# MAX_SYNTHESIS_RETRIES=3
# MAX_DRIFT_MARGIN=0.08
# MIN_SOURCE_ANCHOR=0.55

# -- Phase 5: Preferential Retrieval (SU4) ------------------------------------
# Fraction of queries that skip the super-node score boost (exploration mode).
# EXPLORATION_EPSILON=0.10
# Distance multiplier applied to super-nodes in exploitation mode.
# SUPER_NODE_SCORE_MULTIPLIER=0.85
